generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  refreshToken String?

  urls Url[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Url {
  id         Int       @id @default(autoincrement())
  shortCode  String    @unique
  longUrl    String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  clickCount Int       @default(0)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  // we can use onDelete:SetNull if we don't wanna remove the links after deleting the user.

  @@index([longUrl]) // speeds up to find the duplicate urls
  @@index([userId]) // speeds up 'get all URLs for this user'
}
